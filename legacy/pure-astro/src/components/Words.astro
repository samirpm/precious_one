---
/** Splits a sentence into word spans so the hero headline can rise word by word. */
interface Props {
  text: string;
}
const { text } = Astro.props;
const words = text.split(' ');
---
{words.map((word, i) => (
  <><span class="w" style={`--i:${i}`}><span>{word}</span></span>{i < words.length - 1 ? ' ' : ''}</>
))}
