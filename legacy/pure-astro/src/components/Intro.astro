---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { studio } from '../data/studio';
---

<!--
  A short, once-per-visit opening: the logo settles, a sand line draws
  beneath it, the tagline follows, then the ivory curtain lifts to reveal
  an ink curtain a beat behind it, which lifts to reveal the hero. Hidden
  entirely when the visitor has already seen it or prefers reduced motion.
-->
<div class="intro" aria-hidden="true">
  <div class="intro-panel intro-ink"></div>
  <div class="intro-panel intro-ivory">
    <Image src={logo} alt="" width={220} densities={[1, 2]} loading="eager" class="intro-logo" />
    <span class="intro-line"><i></i></span>
    <p class="intro-text">{studio.tagline}</p>
  </div>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
  }

  .intro-panel {
    position: absolute;
    inset: 0;
  }

  .intro-ink {
    background: var(--color-ink);
    animation: intro-out 0.9s var(--ease-in-out-soft) 1.85s both;
  }

  .intro-ivory {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.1rem;
    background: var(--color-ivory);
    animation: intro-out 0.9s var(--ease-in-out-soft) 1.65s both;
  }

  .intro-logo {
    width: clamp(120px, 26vw, 200px);
    height: auto;
    animation: intro-logo 1.1s var(--ease-out-soft) both;
  }

  .intro-line {
    display: block;
    width: clamp(6rem, 14vw, 10rem);
    height: 1px;
    background: color-mix(in srgb, var(--color-ink) 12%, transparent);
    overflow: hidden;
  }

  .intro-line i {
    display: block;
    height: 100%;
    background: var(--color-sand);
    transform: scaleX(0);
    transform-origin: left;
    animation: intro-line 1.1s var(--ease-in-out-soft) 0.45s both;
  }

  .intro-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-cocoa);
    animation: intro-logo 1s var(--ease-out-soft) 0.7s both;
  }

  @keyframes intro-logo {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes intro-line {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes intro-out {
    to {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }

  :global(html.intro-seen) .intro,
  :global(html.no-js) .intro {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }
</style>
