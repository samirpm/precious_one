---
import Base from '../layouts/Base.astro';
import { studio } from '../data/studio';
---

<Base title={`Page not found | ${studio.name}`} description="That page does not exist.">
  <main class="section not-found">
    <div class="wrap">
      <h1 class="display title-lg">We couldn’t find that page</h1>
      <p class="lede">It may have moved, or the link may be out of date.</p>
      <div class="actions">
        <a class="btn btn-ink" href="/">Back to the home page</a>
        <a class="btn btn-outline" href="/#sessions">See our sessions</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .not-found {
    padding-top: clamp(9rem, 20vh, 14rem);
    min-height: 70vh;
  }

  .not-found .wrap {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
