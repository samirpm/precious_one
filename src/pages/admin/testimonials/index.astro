---
import AdminShell from '@/components/admin/AdminShell.astro';
import { getTestimonials } from '@/lib/services/testimonial.service';

const testimonials = await getTestimonials();
const count = testimonials.length;
const error = Astro.url.searchParams.get('error');
---

<AdminShell title="Testimonials" active="testimonials" error={error}>
  <header class="mb-8 flex items-start justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl font-light">Testimonials</h1>
      <p class="mt-2 text-sm text-charcoal-light">{count} entries · shown in the 3D ring on the homepage.</p>
    </div>
    <a
      href="/admin/testimonials/new"
      class="bg-champagne px-5 py-3 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-champagne-light"
    >
      + Add Testimonial
    </a>
  </header>

  <div class="space-y-3">
    {testimonials.map((t, index) => (
      <div class="flex items-center gap-4 border border-charcoal/10 bg-white p-3">
        {t.imageUrl && (
          <img src={t.imageUrl} alt={t.altText || t.name} class="h-16 w-16 shrink-0 object-cover" loading="lazy" />
        )}
        <div class="min-w-0 flex-1">
          <p class="truncate font-serif text-base">{t.name} <span class="text-xs text-charcoal-light">{'★'.repeat(t.rating)}</span></p>
          <p class="truncate text-xs text-charcoal-light">{t.quote}</p>
        </div>

        <div class="flex items-center gap-2">
          <form method="POST" action={`/api/admin/testimonials/${t.id}?action=toggle`}>
            <button
              type="submit"
              class:list={[
                'rounded px-2 py-1 text-xs',
                t.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-700',
              ]}
            >
              {t.isActive ? 'Published' : 'Hidden'}
            </button>
          </form>

          <div class="flex items-center gap-1">
            <form method="POST" action={`/api/admin/testimonials/${t.id}?action=move`}>
              <input type="hidden" name="direction" value="up" />
              <button type="submit" class="px-1 text-xs text-charcoal-light hover:text-charcoal" disabled={index === 0}>▲</button>
            </form>
            <form method="POST" action={`/api/admin/testimonials/${t.id}?action=move`}>
              <input type="hidden" name="direction" value="down" />
              <button type="submit" class="px-1 text-xs text-charcoal-light hover:text-charcoal" disabled={index === count - 1}>▼</button>
            </form>
          </div>

          <a href={`/admin/testimonials/${t.id}/edit`} class="rounded px-2 py-1 text-xs hover:bg-charcoal/5">Edit</a>

          <form method="POST" action={`/api/admin/testimonials/${t.id}?action=delete`} data-confirm>
            <button type="submit" class="rounded px-2 py-1 text-xs text-red-700 hover:bg-red-50">Delete</button>
          </form>
        </div>
      </div>
    ))}
  </div>

  {count === 0 && (
    <p class="border border-dashed border-charcoal/20 p-10 text-center text-sm text-charcoal-light">
      No testimonials yet — add your first one.
    </p>
  )}
</AdminShell>
