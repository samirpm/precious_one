---
import AdminShell from '@/components/admin/AdminShell.astro';
import { getServices } from '@/lib/services/service.service';

const services = await getServices();
const count = services.length;
const error = Astro.url.searchParams.get('error');
---

<AdminShell title="Services" active="services" error={error}>
  <header class="mb-8 flex items-start justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl font-light">Services & Packages</h1>
      <p class="mt-2 text-sm text-charcoal-light">{count} services · shown on the homepage and services pages.</p>
    </div>
    <a
      href="/admin/services/new"
      class="bg-champagne px-5 py-3 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-champagne-light"
    >
      + Add Service
    </a>
  </header>

  <div class="space-y-3">
    {services.map((service, index) => (
      <div class="flex items-center gap-4 border border-charcoal/10 bg-white p-3">
        <img src={service.imageUrl} alt={service.title} class="h-16 w-16 shrink-0 object-cover" loading="lazy" />
        <div class="min-w-0 flex-1">
          <p class="truncate font-serif text-base">{service.title}</p>
          <p class="truncate text-xs text-charcoal-light">
            /{service.slug} · {service.category} · {service.packages.length} packages
          </p>
        </div>

        <div class="flex items-center gap-2">
          <form method="POST" action={`/api/admin/services/${service.id}?action=toggle`}>
            <button
              type="submit"
              class:list={[
                'rounded px-2 py-1 text-xs',
                service.published ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-700',
              ]}
            >
              {service.published ? 'Published' : 'Hidden'}
            </button>
          </form>

          <div class="flex items-center gap-1">
            <form method="POST" action={`/api/admin/services/${service.id}?action=move`}>
              <input type="hidden" name="direction" value="up" />
              <button type="submit" class="px-1 text-xs text-charcoal-light hover:text-charcoal" disabled={index === 0}>▲</button>
            </form>
            <form method="POST" action={`/api/admin/services/${service.id}?action=move`}>
              <input type="hidden" name="direction" value="down" />
              <button type="submit" class="px-1 text-xs text-charcoal-light hover:text-charcoal" disabled={index === count - 1}>▼</button>
            </form>
          </div>

          <a href={`/admin/services/${service.id}/packages`} class="rounded px-2 py-1 text-xs hover:bg-charcoal/5">
            Packages
          </a>
          <a href={`/admin/services/${service.id}/edit`} class="rounded px-2 py-1 text-xs hover:bg-charcoal/5">
            Edit
          </a>

          <form method="POST" action={`/api/admin/services/${service.id}?action=delete`} data-confirm>
            <button type="submit" class="rounded px-2 py-1 text-xs text-red-700 hover:bg-red-50">Delete</button>
          </form>
        </div>
      </div>
    ))}
  </div>

  {count === 0 && (
    <p class="border border-dashed border-charcoal/20 p-10 text-center text-sm text-charcoal-light">
      No services yet — add your first one.
    </p>
  )}
</AdminShell>
