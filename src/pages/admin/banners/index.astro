---
import AdminShell from '@/components/admin/AdminShell.astro';
import { getBanners } from '@/lib/services/banner.service';

const banners = await getBanners();
const count = banners.length;
const atMax = count >= 5;
const atMin = count <= 3;
const error = Astro.url.searchParams.get('error');
---

<AdminShell title="Banners" active="banners" error={error}>
  <header class="mb-8 flex items-start justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl font-light">Banners</h1>
      <p class="mt-2 text-sm text-charcoal-light">
        {count} / 5 banners · hero carousel slides (minimum 3, maximum 5)
      </p>
    </div>
    <a
      href="/admin/banners/new"
      class:list={[
        'bg-champagne px-5 py-3 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-champagne-light',
        atMax && 'pointer-events-none opacity-40',
      ]}
      aria-disabled={atMax}
    >
      + Add Banner
    </a>
  </header>

  <div class="space-y-3">
    {banners.map((banner, index) => (
      <div class="flex items-center gap-4 border border-charcoal/10 bg-white p-3">
        <img src={banner.imageUrl} alt={banner.title} class="h-16 w-16 shrink-0 object-cover" loading="lazy" />
        <div class="min-w-0 flex-1">
          <p class="truncate font-serif text-base">{banner.title}</p>
          <p class="truncate text-xs text-charcoal-light">
            {banner.subtitle ?? ''} · order {banner.displayOrder}
          </p>
        </div>

        <div class="flex items-center gap-2">
          <form method="POST" action={`/api/admin/banners/${banner.id}?action=toggle`}>
            <button
              type="submit"
              class:list={[
                'rounded px-2 py-1 text-xs',
                banner.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-700',
              ]}
            >
              {banner.isActive ? 'Active' : 'Inactive'}
            </button>
          </form>

          <div class="flex items-center gap-1">
            <form method="POST" action={`/api/admin/banners/${banner.id}?action=move`}>
              <input type="hidden" name="direction" value="up" />
              <button type="submit" class="px-1 text-xs text-charcoal-light hover:text-charcoal" title="Move up" disabled={index === 0}>▲</button>
            </form>
            <form method="POST" action={`/api/admin/banners/${banner.id}?action=move`}>
              <input type="hidden" name="direction" value="down" />
              <button type="submit" class="px-1 text-xs text-charcoal-light hover:text-charcoal" title="Move down" disabled={index === count - 1}>▼</button>
            </form>
          </div>

          <a href={`/admin/banners/${banner.id}/edit`} class="rounded px-2 py-1 text-xs hover:bg-charcoal/5">
            Edit
          </a>

          <form method="POST" action={`/api/admin/banners/${banner.id}?action=delete`} data-confirm>
            <button
              type="submit"
              class:list={[
                'rounded px-2 py-1 text-xs text-red-700 hover:bg-red-50',
                atMin && 'pointer-events-none opacity-40',
              ]}
              disabled={atMin}
              title={atMin ? 'At least 3 banners are required.' : undefined}
            >
              Delete
            </button>
          </form>
        </div>
      </div>
    ))}
  </div>

  {count === 0 && (
    <p class="border border-dashed border-charcoal/20 p-10 text-center text-sm text-charcoal-light">
      No banners yet — add your first one.
    </p>
  )}
</AdminShell>
