---
import AdminShell from '@/components/admin/AdminShell.astro';
import { getPortfolioImages } from '@/lib/services/portfolio.service';

const photos = await getPortfolioImages();
const count = photos.length;
const atMax = count >= 30;
const atMin = count <= 10;
const error = Astro.url.searchParams.get('error');
---

<AdminShell title="Portfolio" active="portfolio" error={error}>
  <header class="mb-8 flex items-start justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl font-light">Portfolio</h1>
      <p class="mt-2 text-sm text-charcoal-light">
        {count} / 30 photos · shown on the homepage gallery and services pages (minimum 10)
      </p>
    </div>
    <a
      href="/admin/portfolio/new"
      class:list={[
        'bg-champagne px-5 py-3 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-champagne-light',
        atMax && 'pointer-events-none opacity-40',
      ]}
      aria-disabled={atMax}
    >
      + Add Photo
    </a>
  </header>

  <div class="space-y-3">
    {photos.map((photo, index) => (
      <div class="flex items-center gap-4 border border-charcoal/10 bg-white p-3">
        <img src={photo.imageUrl} alt={photo.title} class="h-16 w-16 shrink-0 object-cover" loading="lazy" />
        <div class="min-w-0 flex-1">
          <p class="truncate font-serif text-base">{photo.title}</p>
          <p class="truncate text-xs text-charcoal-light">
            {photo.category} · order {photo.displayOrder}
          </p>
        </div>

        <div class="flex items-center gap-2">
          <form method="POST" action={`/api/admin/portfolio/${photo.id}?action=toggle-featured`}>
            <button
              type="submit"
              class:list={[
                'rounded px-2 py-1 text-xs',
                photo.featured ? 'bg-champagne/15 text-champagne-dark' : 'bg-charcoal/5 text-charcoal-light',
              ]}
              title="Toggle featured"
            >
              ★ Featured
            </button>
          </form>

          <form method="POST" action={`/api/admin/portfolio/${photo.id}?action=toggle`}>
            <button
              type="submit"
              class:list={[
                'rounded px-2 py-1 text-xs',
                photo.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-700',
              ]}
              title="Toggle published"
            >
              {photo.isActive ? 'Published' : 'Hidden'}
            </button>
          </form>

          <div class="flex items-center gap-1">
            <form method="POST" action={`/api/admin/portfolio/${photo.id}?action=move`}>
              <input type="hidden" name="direction" value="up" />
              <button type="submit" class="px-1 text-xs text-charcoal-light hover:text-charcoal" title="Move up" disabled={index === 0}>▲</button>
            </form>
            <form method="POST" action={`/api/admin/portfolio/${photo.id}?action=move`}>
              <input type="hidden" name="direction" value="down" />
              <button type="submit" class="px-1 text-xs text-charcoal-light hover:text-charcoal" title="Move down" disabled={index === count - 1}>▼</button>
            </form>
          </div>

          <a href={`/admin/portfolio/${photo.id}/edit`} class="rounded px-2 py-1 text-xs hover:bg-charcoal/5">
            Edit
          </a>

          <form method="POST" action={`/api/admin/portfolio/${photo.id}?action=delete`} data-confirm>
            <button
              type="submit"
              class:list={[
                'rounded px-2 py-1 text-xs text-red-700 hover:bg-red-50',
                atMin && 'pointer-events-none opacity-40',
              ]}
              disabled={atMin}
              title={atMin ? 'At least 10 portfolio images are required.' : undefined}
            >
              Delete
            </button>
          </form>
        </div>
      </div>
    ))}
  </div>

  {count === 0 && (
    <p class="border border-dashed border-charcoal/20 p-10 text-center text-sm text-charcoal-light">
      No photos yet — add your first one.
    </p>
  )}
</AdminShell>
