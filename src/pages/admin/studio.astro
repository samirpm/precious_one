---
import AdminShell from '@/components/admin/AdminShell.astro';
import { prisma } from '@/lib/prisma';
import type { StudioInfo } from '@prisma/client';

const info = await prisma.studioInfo.findUnique({ where: { id: 1 } });
const bookingMethods = ['whatsapp', 'phone', 'email', 'form'];
const error = Astro.url.searchParams.get('error');

const fields: Array<{ name: keyof StudioInfo; label: string; textarea?: boolean }> = [
  { name: 'name', label: 'Studio name' },
  { name: 'tagline', label: 'Tagline' },
  { name: 'description', label: 'Description', textarea: true },
  { name: 'speciality', label: 'Speciality copy', textarea: true },
  { name: 'privacy', label: 'Privacy copy', textarea: true },
  { name: 'phone', label: 'Phone' },
  { name: 'whatsapp', label: 'WhatsApp number' },
  { name: 'email', label: 'Email' },
  { name: 'address', label: 'Address' },
  { name: 'openingHours', label: 'Opening hours' },
  { name: 'instagram', label: 'Instagram URL' },
];
---

<AdminShell title="Studio Info" active="studio" error={error}>
  <header class="mb-8">
    <h1 class="font-serif text-3xl font-light">Studio Info & Contact</h1>
    <p class="mt-2 text-sm text-charcoal-light">Contact details and copy shown across the site.</p>
  </header>

  <form method="POST" action="/api/admin/studio" class="max-w-2xl space-y-6">
    <div class="space-y-5 border border-charcoal/10 bg-white p-6">
      {fields.map((field) => (
        <div>
          <label
            for={field.name}
            class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe"
          >
            {field.label}
          </label>
          {field.textarea ? (
            <textarea
              id={field.name}
              name={field.name}
              rows="4"
              class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne"
            >{info ? info[field.name] : ''}</textarea>
          ) : (
            <input
              id={field.name}
              name={field.name}
              type="text"
              value={info ? String(info[field.name]) : ''}
              class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne"
            />
          )}
        </div>
      ))}

      <div>
        <label for="bookingMethod" class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe">
          Booking method
        </label>
        <select
          id="bookingMethod"
          name="bookingMethod"
          class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne"
        >
          {bookingMethods.map((m) => (
            <option value={m} selected={info?.bookingMethod === m}>{m}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <button
        type="submit"
        class="bg-champagne px-8 py-3 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-champagne-light"
      >
        Save Changes
      </button>
    </div>
  </form>
</AdminShell>
