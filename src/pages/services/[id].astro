---
import Layout from '@/components/Layout.astro';
import Header from '@/components/navigation/Header';
import ServiceDetail from '@/components/sections/ServiceDetail';
import Footer from '@/components/navigation/Footer.astro';
import FilmGrain from '@/components/ui/FilmGrain.astro';
import CustomCursor from '@/components/ui/CustomCursor';
import ScrollProgress from '@/components/ui/ScrollProgress';
import { getServiceBySlug, getServices, getStudioInfo } from '@/lib/data';

// SSR: look up the service by slug from PostgreSQL (edited via /admin)
const service = Astro.params.id
  ? await getServiceBySlug(Astro.params.id)
  : null;

if (!service) {
  return Astro.redirect('/404');
}

const [services, studioInfo] = await Promise.all([
  getServices(),
  getStudioInfo().catch(() => null),
]);

const { title, description } = service;
---

<Layout title={title} description={description} ogImage={service.imageUrl}>
  {/* Persistent overlays */}
  <CustomCursor client:load />
  <ScrollProgress client:load />
  <FilmGrain />
  <Header client:load isVisible={true} />

  <main class="min-h-screen overflow-x-clip bg-ivory">
    <ServiceDetail client:load service={service} services={services} studioInfo={studioInfo} />
    <Footer />
  </main>
</Layout>