---
import { Picture } from 'astro:assets';
import Words from '../../components/Words.astro';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import WhatsAppIcon from '../../components/icons/WhatsAppIcon.astro';
import { photoById } from '../../data/photos';
import { fromPrice, services, studio, whatsappLink } from '../../data/studio';

export function getStaticPaths() {
  return services.map((service) => ({ params: { id: service.id }, props: { service } }));
}

const { service } = Astro.props;
const cover = photoById(service.photos[0]);
const gallery = service.photos.slice(1).map(photoById);
const others = services.filter((s) => s.id !== service.id);
const message = `Hello Precious One, I would like to book a ${service.name.toLowerCase()} session.`;
---

<Base
  title={`${service.title} in Abu Dhabi | ${studio.name}`}
  description={`${service.summary} ${service.idealFor} Packages from ${fromPrice(service)}.`}
  ogImage={cover.src}
  overlayHeader
>
  <main>
    <section class="service-hero" data-hero>
      <div class="frame service-hero-media" aria-hidden="true" style={`view-transition-name: service-${service.id}`}>
        <Picture
          src={cover.src}
          alt=""
          widths={[480, 768, 1024, Math.min(cover.src.width, 1600)]}
          sizes="(min-width: 1024px) 56vw, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
        <div class="service-hero-scrim"></div>
      </div>
      <div class="service-hero-panel">
        <nav class="crumbs meta" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/#sessions">Sessions</a>
        </nav>
        <h1 class="display words words-load"><Words text={service.title} /></h1>
        <p class="service-hero-sub">{service.summary}</p>
        <div class="service-hero-actions">
          <a class="btn btn-primary" href={whatsappLink(message)} target="_blank" rel="noopener">
            <WhatsAppIcon />
            Book on WhatsApp
          </a>
          <a class="btn btn-light" href="#packages">Packages from {fromPrice(service)}</a>
        </div>
      </div>
    </section>

    <section class="section service-story">
      <div class="wrap story-grid">
        <div class="story-text">
          <h2 class="display title-md reveal">What the session is like</h2>
          <p class="prose-soft reveal" style="--d: 0.1s">{service.story}</p>
        </div>
        <aside class="story-aside reveal" style="--d: 0.2s">
          <dl>
            <div>
              <dt>Best for</dt>
              <dd>{service.idealFor}</dd>
            </div>
            <div>
              <dt>Where</dt>
              <dd>Our private studio in {studio.city}</dd>
            </div>
            <div>
              <dt>Packages</dt>
              <dd>From {fromPrice(service)}</dd>
            </div>
          </dl>
          <a class="btn btn-ink" href={whatsappLink(message)} target="_blank" rel="noopener">
            <WhatsAppIcon />
            Check availability
          </a>
        </aside>
      </div>
    </section>

    {gallery.length > 0 && (
      <section class="section-tight service-gallery" aria-label={`${service.title} photographs`}>
        <div class="wrap">
          <ul class="gallery-grid">
            {gallery.map((photo, i) => (
              <li class="reveal-clip" style={`--d: ${i * 0.08}s`}>
                <button type="button" class="frame-button" data-lightbox={photo.id} aria-label={`Open photograph: ${photo.caption}`}>
                  <div class="frame">
                    <Picture
                      src={photo.src}
                      alt={photo.alt}
                      widths={[480, 768, 1024]}
                      sizes="(min-width: 768px) 50vw, 100vw"
                      formats={['avif', 'webp']}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section id="packages" class="section packages" aria-labelledby="packages-title">
      <div class="wrap">
        <div class="packages-head">
          <h2 id="packages-title" class="display title-lg reveal">Packages</h2>
          <p class="prose-soft reveal" style="--d: 0.1s">
            Every package includes the session in our private studio, hand-edited photographs and a private online gallery. Prints and albums can be added to any package.
          </p>
        </div>
        <ul class="tiers">
          {service.packages.map((pkg, i) => (
            <li class:list={['tier reveal', { 'is-popular': pkg.popular }]} style={`--d: ${0.1 + i * 0.1}s`}>
              {pkg.popular && <p class="tier-tag">Most chosen</p>}
              <h3 class="title-sm">{pkg.name}</h3>
              <p class="tier-price display">{pkg.price}</p>
              <ul class="tier-list">
                {pkg.includes.map((line) => <li>{line}</li>)}
              </ul>
              <a
                class:list={['btn', pkg.popular ? 'btn-primary' : 'btn-outline']}
                href={whatsappLink(`Hello Precious One, I would like to book the ${pkg.name} ${service.name.toLowerCase()} package.`)}
                target="_blank"
                rel="noopener"
              >
                Book {pkg.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section-tight more" aria-labelledby="more-title">
      <div class="wrap">
        <h2 id="more-title" class="display title-md reveal">Other sessions</h2>
        <ul class="more-grid">
          {others.map((s, i) => {
            const photo = photoById(s.photos[0]);
            return (
              <li class="reveal" style={`--d: ${i * 0.06}s`}>
                <a href={`/services/${s.id}/`} class="more-card">
                  <div class="frame" style={`view-transition-name: service-${s.id}`}>
                    <Picture
                      src={photo.src}
                      alt={photo.alt}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 1024px) 18vw, (min-width: 640px) 30vw, 46vw"
                      formats={['avif', 'webp']}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <span class="title-sm">{s.name}</span>
                  <span class="meta">From {fromPrice(s)}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <Contact message={message} photoId={service.photos[1] ?? 'basket'} />
  </main>
</Base>

<style>
  /* Same split as the home page hero: copy on an ink panel, photo beside it. */
  .service-hero {
    --gutter: clamp(1.25rem, 5vw, 4.5rem);
    display: grid;
    grid-template-rows: 52svh auto;
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .service-hero-media {
    position: relative;
    overflow: hidden;
    background: var(--color-ink-soft);
  }

  .service-hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(28, 22, 18, 0.45) 0%, rgba(28, 22, 18, 0) 32%);
    pointer-events: none;
  }

  .service-hero-panel {
    display: grid;
    gap: 1rem;
    align-content: center;
    justify-items: start;
    padding: 2.25rem var(--gutter) 2.5rem;
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    color: color-mix(in srgb, var(--color-ivory) 60%, transparent);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--color-ivory);
  }

  .service-hero h1 {
    font-size: clamp(2.5rem, 10vw, 3.5rem);
    max-width: 10em;
    color: var(--color-ivory);
  }

  .service-hero-sub {
    max-width: 36ch;
    font-size: 1.0625rem;
    color: color-mix(in srgb, var(--color-ivory) 78%, transparent);
  }

  .service-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 1024px) {
    .service-hero {
      grid-template-rows: none;
      grid-template-columns: minmax(0, 44%) minmax(0, 56%);
      min-height: 78svh;
      max-height: 56rem;
    }

    .service-hero-media {
      order: 2;
    }

    .service-hero-panel {
      order: 1;
      padding: 7.5rem var(--gutter) 3rem;
      gap: 1.25rem;
    }

    .service-hero h1 {
      font-size: clamp(3rem, 4.4vw, 4.75rem);
    }

    .service-hero-sub {
      font-size: 1.125rem;
    }
  }

  .story-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .story-grid {
      grid-template-columns: 1.3fr 0.7fr;
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }
  }

  .story-text {
    display: grid;
    gap: 1.25rem;
  }

  .story-text .prose-soft {
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .story-aside {
    display: grid;
    gap: 1.5rem;
    padding: 1.75rem;
    background: var(--color-parchment);
  }

  @media (min-width: 1024px) {
    .story-aside {
      position: sticky;
      top: 7rem;
    }
  }

  .story-aside dl {
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .story-aside dt {
    font-size: 0.8125rem;
    color: var(--color-cocoa);
    margin-bottom: 0.15rem;
  }

  .story-aside dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .story-aside .btn {
    width: 100%;
  }

  .service-gallery {
    background: var(--color-ink);
    --cover: var(--color-ink);
    padding-block: clamp(1.5rem, 3vw, 3rem);
  }

  .gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .gallery-grid .frame {
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    .gallery-grid li:first-child:nth-last-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .packages-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  @media (min-width: 768px) {
    .packages-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 3rem;
    }
  }

  .tiers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .tiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .tier {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 2rem 1.75rem;
    background: var(--color-white);
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  .tier.is-popular {
    background: var(--color-ink);
    color: var(--color-ivory);
    border-color: var(--color-ink);
  }

  .tier-tag {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-sand);
  }

  .tier-price {
    font-size: 2.5rem;
  }

  .tier-list {
    list-style: none;
    margin: 0.25rem 0 0.5rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .tier-list li {
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
  }

  .tier .btn {
    width: 100%;
    margin-top: auto;
  }

  .tier.is-popular .btn-primary {
    border-color: var(--color-sand);
  }

  .more {
    background: var(--color-ivory);
  }

  .more h2 {
    margin-bottom: 1.5rem;
  }

  .more-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  @media (min-width: 640px) {
    .more-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .more-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .more-card {
    display: grid;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }

  .more-card .frame {
    aspect-ratio: 4 / 5;
    margin-bottom: 0.4rem;
  }

  .more-card .frame :global(img) {
    transition: transform 1.2s var(--ease-out-soft);
  }

  @media (hover: hover) {
    .more-card:hover .frame :global(img) {
      transform: scale(1.04);
    }
  }
</style>
