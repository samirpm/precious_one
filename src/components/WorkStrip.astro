---
import { Picture } from 'astro:assets';
import { photoById, photos, stripPhotoIds } from '../data/photos';
import { whatsappLink } from '../data/studio';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

const strip = stripPhotoIds.map(photoById);
---

<!--
  The signature moment of the site. On large screens the section pins and the
  photographs glide sideways as you scroll, driven entirely by a CSS
  scroll-driven animation. Everywhere else (phones, older browsers, reduced
  motion) it is a native swipe strip. Either way, every photograph opens the
  lightbox.
-->
<section id="work" class="work dark" aria-labelledby="work-title">
  <div class="work-pin">
    <div class="work-stage">
      <div class="work-intro">
        <h2 id="work-title" class="display title-lg">Recent sessions</h2>
        <p class="lede">
          Newborns, brand-new siblings and whole families, photographed in our Abu Dhabi studio.
        </p>
        <div class="work-intro-actions">
          <button type="button" class="btn btn-light" data-lightbox={strip[0].id}>
            View all {photos.length} photographs
          </button>
        </div>
        <p class="meta work-hint" aria-hidden="true">
          <span class="hint-scroll">Keep scrolling</span>
          <span class="hint-swipe">Swipe</span>
        </p>
      </div>

      <div class="work-viewport">
        <ul class="work-track no-scrollbar">
          {strip.map((photo, i) => (
            <li class="work-item">
              <button type="button" class="frame-button" data-lightbox={photo.id} aria-label={`Open photograph: ${photo.caption}`}>
                <div class="frame">
                  <Picture
                    src={photo.src}
                    alt={photo.alt}
                    widths={[480, 720, 960, Math.min(photo.src.width, 1280)]}
                    sizes="(min-width: 1024px) 60vw, 84vw"
                    formats={['avif', 'webp']}
                    loading={i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
                <span class="work-caption">
                  <span>{photo.caption}</span>
                  <span class="meta">{i + 1} of {strip.length}</span>
                </span>
              </button>
            </li>
          ))}
          <li class="work-item work-end">
            <p class="display title-md">Ready to plan yours?</p>
            <p class="prose-soft">Tell us your due date or your baby’s age and we’ll suggest a session.</p>
            <a class="btn btn-primary" href={whatsappLink('Hello Precious One, I would like to plan a session.')} target="_blank" rel="noopener">
              <WhatsAppIcon />
              Chat on WhatsApp
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .work {
    --gutter: clamp(1.25rem, 5vw, 4.5rem);
  }

  .work-stage {
    padding-block: clamp(4.5rem, 9vw, 8rem) clamp(3.5rem, 7vw, 6rem);
  }

  .work-intro {
    padding-inline: var(--gutter);
    max-width: 90rem;
    margin-inline: auto;
    margin-bottom: 2.25rem;
  }

  .work-intro .lede {
    margin-top: 1rem;
    max-width: 30ch;
  }

  .work-intro-actions {
    margin-top: 1.5rem;
  }

  .work-hint {
    margin-top: 1.5rem;
  }

  .hint-scroll {
    display: none;
  }

  .work-viewport {
    min-width: 0;
  }

  .work-track {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    -webkit-overflow-scrolling: touch;
  }

  .work-item {
    flex: 0 0 84vw;
    max-width: 34rem;
    scroll-snap-align: start;
  }

  .work-item .frame {
    aspect-ratio: 3 / 2;
  }

  .work-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    color: color-mix(in srgb, var(--color-ivory) 82%, transparent);
  }

  .work-end {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 1rem 2rem 0.5rem;
    max-width: 22rem;
  }

  .work-end .btn {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  /* Pinned, scroll-driven version for large screens */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .work-pin {
        height: 560vh;
        view-timeline-name: --work;
        view-timeline-axis: block;
      }

      .work-stage {
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        align-items: center;
        padding: 0;
        overflow: hidden;
      }

      .work-intro {
        flex: 0 0 32vw;
        margin: 0;
        padding-left: var(--gutter);
        padding-right: 2vw;
      }

      .hint-scroll {
        display: inline;
      }

      .hint-swipe {
        display: none;
      }

      .work-viewport {
        flex: 1 1 auto;
        height: 100%;
        display: flex;
        align-items: center;
        overflow: hidden;
      }

      .work-track {
        overflow: visible;
        scroll-snap-type: none;
        gap: 2.5vw;
        padding: 0 8vw 0 2vw;
        animation: work-slide linear both;
        animation-timeline: --work;
        animation-range: contain 0% contain 100%;
        will-change: transform;
      }

      .work-item {
        flex: 0 0 auto;
        max-width: none;
      }

      .work-item .frame {
        height: 64vh;
        width: calc(64vh * 1.5);
        aspect-ratio: auto;
      }

      .work-end {
        padding-left: 3vw;
        max-width: 26rem;
      }

      @keyframes work-slide {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(calc(68vw - 100%));
        }
      }
    }
  }

  @media (pointer: fine) {
    .work-track {
      scrollbar-width: thin;
      scrollbar-color: color-mix(in srgb, var(--color-ivory) 30%, transparent) transparent;
    }
  }
</style>
