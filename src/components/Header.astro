---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { studio, telLink, whatsappLink } from '../data/studio';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

interface Props {
  /** Start transparent over a full-bleed hero, turn solid on scroll. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Sessions', href: '/#sessions' },
  { label: 'The studio', href: '/#studio' },
  { label: 'Questions', href: '/#questions' },
];
---

<header class:list={['site-header', { 'is-overlay': overlay, 'is-solid': !overlay }]} data-header>
  <div class="wrap header-row">
    <a href="/" class="brand" aria-label={`${studio.name}, home`}>
      <Image src={logo} alt="" width={44} height={36} densities={[1, 2]} loading="eager" class="brand-mark" />
      <span class="brand-name">{studio.shortName}</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a href={telLink} class="phone">{studio.phone}</a>
      <a href={whatsappLink('Hello Precious One, I would like to ask about a session.')} class="btn btn-primary btn-header" target="_blank" rel="noopener">
        <WhatsAppIcon />
        Chat on WhatsApp
      </a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="sr-only">Menu</span>
        <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div id="site-menu" class="menu" hidden data-menu>
  <nav class="wrap menu-inner" aria-label="Mobile">
    <ul class="menu-list">
      {nav.map((item) => (
        <li><a href={item.href} data-menu-link>{item.label}</a></li>
      ))}
    </ul>
    <div class="menu-contact">
      <a href={whatsappLink('Hello Precious One, I would like to ask about a session.')} class="btn btn-primary" target="_blank" rel="noopener">
        <WhatsAppIcon />
        Chat on WhatsApp
      </a>
      <a href={telLink} class="btn btn-outline">Call {studio.phone}</a>
      <p class="meta">{studio.tagline}</p>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    --fg: var(--color-ink);
    color: var(--fg);
    transition:
      background-color 0.4s ease,
      color 0.4s ease,
      box-shadow 0.4s ease,
      transform 0.5s var(--ease-out-soft);
  }

  .site-header.is-overlay {
    --fg: var(--color-white);
  }

  .site-header.is-solid {
    --fg: var(--color-ink);
    background: color-mix(in srgb, var(--color-ivory) 94%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  /* Tucks away while reading down the page, returns on the first scroll up. */
  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-header.is-solid {
      background: color-mix(in srgb, var(--color-ivory) 86%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  }

  :global(html.has-intro:not(.intro-seen)) .site-header {
    animation: header-in 0.8s var(--ease-out-soft) 2.5s both;
  }

  @keyframes header-in {
    from {
      transform: translateY(-0.5rem);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.5rem;
  }

  @media (min-width: 1024px) {
    .header-row {
      height: 5.25rem;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    width: 2.75rem;
    height: auto;
    border-radius: 999px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .nav-desktop {
    display: none;
    gap: 2.25rem;
  }

  .nav-desktop a {
    position: relative;
    color: inherit;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 400;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .nav-desktop a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out-soft);
  }

  .nav-desktop a:hover {
    opacity: 1;
  }

  .nav-desktop a:hover::after {
    transform: none;
    transform-origin: left;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .phone {
    display: none;
    color: inherit;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    font-size: 0.9375rem;
    opacity: 0.85;
  }

  .btn-header {
    display: none;
  }

  @media (min-width: 768px) {
    .btn-header {
      display: inline-flex;
    }
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: flex;
    }
    .phone {
      display: inline;
    }
    .menu-toggle {
      display: none;
    }
  }

  .menu-toggle {
    position: relative;
    z-index: 70;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
  }

  .menu-lines {
    position: relative;
    width: 1.5rem;
    height: 0.75rem;
    display: block;
  }

  .menu-lines i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition:
      transform 0.35s var(--ease-out-soft),
      top 0.35s var(--ease-out-soft);
  }

  .menu-lines i:first-child {
    top: 0;
  }

  .menu-lines i:last-child {
    top: 100%;
  }

  :global(html.menu-open) .menu-toggle {
    color: var(--color-ink);
  }

  :global(html.menu-open) .menu-lines i:first-child {
    top: 50%;
    transform: rotate(45deg);
  }

  :global(html.menu-open) .menu-lines i:last-child {
    top: 50%;
    transform: rotate(-45deg);
  }

  /* Mobile menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 65;
    background: var(--color-ivory);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .menu[hidden] {
    display: none;
  }

  .menu.is-open {
    opacity: 1;
  }

  .menu-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding-top: 6.5rem;
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
  }

  .menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-list a {
    display: block;
    padding: 1rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-ink);
    text-decoration: none;
  }

  .menu-contact {
    display: grid;
    gap: 0.75rem;
    padding-top: 2rem;
  }

  .menu-contact .btn {
    width: 100%;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const root = document.documentElement;

  // Turn solid once the hero has scrolled away. Pages without a hero
  // start solid and never change.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (header && hero && header.classList.contains('is-overlay')) {
    const io = new IntersectionObserver(
      ([entry]) => {
        const past = !entry.isIntersecting;
        header.classList.toggle('is-solid', past);
        header.classList.toggle('is-overlay', !past);
      },
      { rootMargin: '-80px 0px 0px 0px', threshold: 0 },
    );
    io.observe(hero);
  }

  // Hide on scroll down, show on scroll up (never while the menu is open).
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          const delta = y - lastY;
          if (!root.classList.contains('menu-open')) {
            if (y > 320 && delta > 6) header.classList.add('is-hidden');
            else if (delta < -6 || y < 320) header.classList.remove('is-hidden');
          }
          lastY = y;
          ticking = false;
        });
      },
      { passive: true },
    );
  }

  let closeTimer = 0;
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    root.classList.toggle('menu-open', open);
    window.clearTimeout(closeTimer);
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add('is-open'));
    } else {
      menu.classList.remove('is-open');
      closeTimer = window.setTimeout(() => {
        menu.hidden = true;
      }, 350);
    }
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root.classList.contains('menu-open')) setOpen(false);
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
