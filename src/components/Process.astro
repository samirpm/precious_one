---
import { steps, whatsappLink } from '../data/studio';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---

<section id="how" class="section process" aria-labelledby="how-title">
  <div class="wrap">
    <div class="process-head">
      <h2 id="how-title" class="display title-lg reveal">How a session comes together</h2>
      <a
        class="btn btn-ink reveal"
        style="--d: 0.1s"
        href={whatsappLink('Hello Precious One, I would like to plan a session.')}
        target="_blank"
        rel="noopener"
      >
        <WhatsAppIcon />
        Start on WhatsApp
      </a>
    </div>

    <ol class="steps">
      {steps.map((step, i) => (
        <li class="step reveal" style={`--d: ${0.1 + i * 0.12}s`}>
          <span class="step-number display" aria-hidden="true">{i + 1}</span>
          <h3 class="title-sm">{step.title}</h3>
          <p class="prose-soft">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .process-head h2 {
    max-width: 9em;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    counter-reset: step;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 4rem);
    }
  }

  .step {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    align-content: start;
  }

  .step-number {
    font-size: 3rem;
    color: var(--color-clay);
    line-height: 0.9;
  }

  .step h3 {
    max-width: 18ch;
  }
</style>
