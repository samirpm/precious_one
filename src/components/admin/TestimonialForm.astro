---
import type { Testimonial } from '@prisma/client';

interface Props {
  testimonial?: Testimonial;
}

const { testimonial } = Astro.props;
const isEdit = Boolean(testimonial);
---

<form
  method="POST"
  enctype="multipart/form-data"
  action={testimonial ? `/api/admin/testimonials/${testimonial.id}?action=update` : '/api/admin/testimonials?action=create'}
  class="max-w-2xl space-y-6"
>
  <div class="space-y-5 border border-charcoal/10 bg-white p-6">
    <div>
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="quote">Quote</label>
      <textarea id="quote" name="quote" rows="4" required
        class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne">{testimonial?.quote ?? ''}</textarea>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="name">Name</label>
        <input id="name" name="name" type="text" required value={testimonial?.name ?? ''}
          class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      </div>
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="role">Role / location</label>
        <input id="role" name="role" type="text" value={testimonial?.role ?? ''} placeholder="First-time mum · Al Reem Island"
          class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="rating">Rating (1–5)</label>
        <select id="rating" name="rating"
          class="w-full border border-charcoal/20 bg-white px-4 py-2.5 text-sm outline-none focus:border-champagne">
          {[1, 2, 3, 4, 5].map((r) => (
            <option value={r} selected={(testimonial?.rating ?? 5) === r}>{r}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="displayOrder">Sort order</label>
        <input id="displayOrder" name="displayOrder" type="number" value={testimonial?.displayOrder ?? 0}
          class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      </div>
    </div>

    <div>
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="imageFile">Photo Upload</label>
      {testimonial && testimonial.imageUrl && (
        <img src={testimonial.imageUrl} alt={testimonial.altText || testimonial.name} class="mb-3 h-32 w-32 object-cover" />
      )}
      <input id="imageFile" name="imageFile" type="file" accept="image/*"
        class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      <p class="mt-2 text-xs text-charcoal-light">Optional — select a JPEG, PNG, or WebP image (Max 5MB).</p>
    </div>

    <div>
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="altText">Image alt text</label>
      <input id="altText" name="altText" type="text" value={testimonial?.altText ?? ''}
        class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
    </div>

    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="isActive" checked={testimonial?.isActive ?? true} class="h-4 w-4 accent-champagne" />
      Published (visible on site)
    </label>
  </div>

  <div class="flex items-center gap-4">
    <button
      type="submit"
      class="bg-champagne px-8 py-3 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-champagne-light"
    >
      {isEdit ? 'Save Changes' : 'Add Testimonial'}
    </button>
    <a href="/admin/testimonials" class="text-sm text-charcoal-light hover:text-charcoal">Cancel</a>
  </div>
</form>
