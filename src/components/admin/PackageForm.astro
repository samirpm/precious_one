---
import type { Package } from '@prisma/client';

interface Props {
  serviceId: string;
  pkg?: Package;
}

const { serviceId, pkg } = Astro.props;
const isEdit = Boolean(pkg);
---

<form
  method="POST"
  enctype="multipart/form-data"
  action={pkg
    ? `/api/admin/packages/${pkg.id}?serviceId=${serviceId}&action=update`
    : `/api/admin/packages?serviceId=${serviceId}`}
  id="package-form"
  class="max-w-2xl space-y-6"
>
  <div class="space-y-5 border border-charcoal/10 bg-white p-6">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="name">Name</label>
        <input id="name" name="name" type="text" required value={pkg?.name ?? ''} placeholder="Signature"
          class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      </div>
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="slug">Slug</label>
        <input id="slug" name="slug" type="text" required value={pkg?.slug ?? ''} placeholder="signature"
          class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      </div>
    </div>

    <div>
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="description">Description</label>
      <textarea id="description" name="description" rows="2"
        class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne">{pkg?.description ?? ''}</textarea>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="price">Price</label>
        <input id="price" name="price" type="number" step="0.01" min="0" required value={pkg ? Number(pkg.price) : ''}
          class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      </div>
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="currency">Currency</label>
        <input id="currency" name="currency" type="text" value={pkg?.currency ?? 'AED'}
          class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      </div>
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="displayOrder">Sort order</label>
        <input id="displayOrder" name="displayOrder" type="number" value={pkg?.displayOrder ?? 0}
          class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      </div>
    </div>

    <div>
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="note">Note</label>
      <input id="note" name="note" type="text" value={pkg?.note ?? ''} placeholder="Most popular"
        class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
    </div>

    <div class="flex items-center gap-6">
      <label class="flex items-center gap-2 text-sm">
        <input type="hidden" name="popular" value="0" />
        <input type="checkbox" name="popular" value="1" checked={pkg?.popular ?? false} class="h-4 w-4 accent-champagne" />
        Mark as most popular
      </label>
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="isActive" checked={pkg?.isActive ?? true} class="h-4 w-4 accent-champagne" />
        Active (shown on site)
      </label>
    </div>

    <div class="pt-4">
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="imageFile">Package Image (Optional)</label>
      {pkg && pkg.imageUrl && (
        <img src={pkg.imageUrl} alt={pkg.name} class="mb-3 h-32 w-32 object-cover" />
      )}
      <input id="imageFile" name="imageFile" type="file" accept="image/*"
        class="w-full border border-charcoal/20 px-4 py-2.5 text-sm outline-none focus:border-champagne" />
      <p class="mt-2 text-xs text-charcoal-light">Optional — select a JPEG, PNG, or WebP image (Max 5MB).</p>
    </div>
  </div>

  <div class="flex items-center gap-4">
    <button
      type="submit"
      class="bg-champagne px-8 py-3 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-champagne-light"
    >
      {isEdit ? 'Save Changes' : 'Add Package'}
    </button>
    <a href={`/admin/services/${serviceId}/packages`} class="text-sm text-charcoal-light hover:text-charcoal">Cancel</a>
  </div>
</form>

<script>
  // Auto-fill the slug from the name while the slug field is untouched.
  const name = document.getElementById('name') as HTMLInputElement | null;
  const slug = document.getElementById('slug') as HTMLInputElement | null;
  let slugTouched = Boolean(slug?.value);
  slug?.addEventListener('input', () => { slugTouched = true; });
  name?.addEventListener('input', () => {
    if (slugTouched || !slug) return;
    slug.value = name.value
      .toLowerCase()
      .replace(/['’]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  });
</script>
