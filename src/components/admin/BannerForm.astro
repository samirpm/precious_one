---
import type { Banner } from '@prisma/client';

interface Props {
  banner?: Banner;
}

const { banner } = Astro.props;
const isEdit = Boolean(banner);
---

<form
  method="POST"
  enctype="multipart/form-data"
  action={banner ? `/api/admin/banners/${banner.id}?action=update` : '/api/admin/banners?action=create'}
  class="max-w-2xl space-y-6"
>
  <div class="space-y-5 border border-charcoal/10 bg-white p-6">
    <div>
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="imageFile">Upload Image</label>
      {banner && <img src={banner.imageUrl} alt={banner.title} class="mb-3 h-32 w-32 object-cover" />}
      <input
        id="imageFile"
        name="imageFile"
        type="file"
        accept="image/*"
        class="w-full border border-charcoal/20 bg-white px-4 py-2.5 text-sm outline-none focus:border-champagne"
      />
      <p class="mt-2 text-xs text-charcoal-light">Select a JPEG, PNG, or WebP image (Max 5MB).</p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="buttonText">Button text</label>
        <input
          id="buttonText"
          name="buttonText"
          type="text"
          value={banner?.buttonText ?? ''}
          placeholder="Book a Session"
          class="w-full border border-charcoal/20 bg-white px-4 py-2.5 text-sm outline-none focus:border-champagne"
        />
      </div>
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="buttonUrl">Button URL</label>
        <input
          id="buttonUrl"
          name="buttonUrl"
          type="text"
          value={banner?.buttonUrl ?? ''}
          placeholder="#contact"
          class="w-full border border-charcoal/20 bg-white px-4 py-2.5 text-sm outline-none focus:border-champagne"
        />
      </div>
    </div>

    <div class="flex items-center gap-6">
      <div class="w-32">
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="displayOrder">Order</label>
        <input
          id="displayOrder"
          name="displayOrder"
          type="number"
          value={banner?.displayOrder ?? 0}
          class="w-full border border-charcoal/20 bg-white px-4 py-2.5 text-sm outline-none focus:border-champagne"
        />
      </div>
      <label class="mt-5 flex items-center gap-2 text-sm">
        <input type="checkbox" name="isActive" checked={banner?.isActive ?? true} class="h-4 w-4 accent-champagne" />
        Active (shown on site)
      </label>
    </div>
  </div>

  <div class="flex items-center gap-4">
    <button
      type="submit"
      class="bg-champagne px-8 py-3 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-champagne-light"
    >
      {isEdit ? 'Save Changes' : 'Add Banner'}
    </button>
    <a href="/admin/banners" class="text-sm text-charcoal-light hover:text-charcoal">Cancel</a>
  </div>
</form>
