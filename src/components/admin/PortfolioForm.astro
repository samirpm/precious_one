---
import type { PortfolioImage } from '@prisma/client';

interface Props {
  photo?: PortfolioImage;
}

const { photo } = Astro.props;
const isEdit = Boolean(photo);
---

<form
  method="POST"
  enctype="multipart/form-data"
  action={photo ? `/api/admin/portfolio/${photo.id}?action=update` : '/api/admin/portfolio?action=create'}
  class="max-w-2xl space-y-6"
>
  <div class="space-y-5 border border-charcoal/10 bg-white p-6">
    <div>
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="title">Title</label>
      <input
        id="title"
        name="title"
        type="text"
        required
        value={photo?.title ?? ''}
        class="w-full border border-charcoal/20 bg-white px-4 py-2.5 text-sm outline-none focus:border-champagne"
      />
    </div>

    <div class="grid gap-5 sm:grid-cols-1">
      <div>
        <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="displayOrder">Sort order</label>
        <input
          id="displayOrder"
          name="displayOrder"
          type="number"
          value={photo?.displayOrder ?? 0}
          class="w-full border border-charcoal/20 bg-white px-4 py-2.5 text-sm outline-none focus:border-champagne"
        />
      </div>
    </div>

    <div>
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="description">Description</label>
      <textarea
        id="description"
        name="description"
        rows="3"
        class="w-full border border-charcoal/20 bg-white px-4 py-2.5 text-sm outline-none focus:border-champagne"
      >{photo?.description ?? ''}</textarea>
    </div>

    <div>
      <label class="mb-2 block text-xs font-medium uppercase tracking-wider text-taupe" for="imageFile">Upload Image</label>
      {photo && (
        <img src={photo.imageUrl} alt={photo.title} class="mb-3 h-32 w-32 object-cover" />
      )}
      <input
        id="imageFile"
        name="imageFile"
        type="file"
        accept="image/*"
        class="w-full border border-charcoal/20 bg-white px-4 py-2.5 text-sm outline-none focus:border-champagne"
      />
      <p class="mt-2 text-xs text-charcoal-light">Select a JPEG, PNG, or WebP image (Max 5MB).</p>
    </div>

    <div class="flex items-center gap-6">
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="featured" checked={photo?.featured ?? false} class="h-4 w-4 accent-champagne" />
        Featured
      </label>
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="isActive" checked={photo?.isActive ?? true} class="h-4 w-4 accent-champagne" />
        Published (visible on site)
      </label>
    </div>
  </div>

  <div class="flex items-center gap-4">
    <button
      type="submit"
      class="bg-champagne px-8 py-3 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-white transition-colors hover:bg-champagne-light"
    >
      {isEdit ? 'Save Changes' : 'Add Photo'}
    </button>
    <a href="/admin/portfolio" class="text-sm text-charcoal-light hover:text-charcoal">Cancel</a>
  </div>
</form>
