---
import { Picture } from 'astro:assets';
import { photoById } from '../data/photos';

// An editorial mosaic: mixed sizes, ragged edges, each photograph drifting at
// its own pace as the page scrolls.
const tiles = [
  { id: 'toes', span: 'a', ratio: '4 / 5' },
  { id: 'basket', span: 'b', ratio: '3 / 2' },
  { id: 'pink-lace', span: 'c', ratio: '4 / 3' },
  { id: 'tutu', span: 'd', ratio: '3 / 4' },
  { id: 'sibling-kiss', span: 'e', ratio: '4 / 5' },
  { id: 'powder-blue', span: 'f', ratio: '3 / 2' },
].map((t) => ({ ...t, photo: photoById(t.id) }));
---

<section class="section details" aria-labelledby="details-title">
  <div class="wrap">
    <div class="details-head">
      <h2 id="details-title" class="display title-lg reveal">The little details</h2>
      <p class="lede reveal" style="--d: 0.1s">
        Fingers and toes, first sleepy smiles, a big sibling’s first kiss. The things you will want to remember exactly
        as they were.
      </p>
    </div>

    <ul class="mosaic">
      {tiles.map((tile, i) => (
        <li class:list={['tile', `tile-${tile.span}`]} style={`--ratio: ${tile.ratio}; --d: ${(i % 3) * 0.1}s`}>
          <button type="button" class="frame-button" data-lightbox={tile.photo.id} aria-label={`Open photograph: ${tile.photo.caption}`}>
            <div class="frame reveal-clip">
              <Picture
                src={tile.photo.src}
                alt={tile.photo.alt}
                widths={[400, 640, 900, 1200]}
                sizes="(min-width: 1024px) 40vw, 50vw"
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="tile-caption">{tile.photo.caption}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .details-head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .details-head .lede {
    max-width: 38ch;
  }

  @media (min-width: 768px) {
    .details-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .mosaic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: start;
  }

  .tile .frame {
    aspect-ratio: var(--ratio);
  }

  .tile-a {
    grid-column: 1 / -1;
  }

  .tile-caption {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.0625rem;
    color: var(--color-cocoa);
  }

  @media (min-width: 1024px) {
    .mosaic {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1.5rem 1.25rem;
    }

    .tile-a {
      grid-column: 1 / 6;
      grid-row: 1 / 3;
    }
    .tile-b {
      grid-column: 6 / 13;
      margin-top: 4rem;
    }
    .tile-c {
      grid-column: 6 / 10;
    }
    .tile-d {
      grid-column: 10 / 13;
      margin-top: 3rem;
    }
    .tile-e {
      grid-column: 1 / 5;
      margin-top: -2rem;
      margin-left: 3rem;
    }
    .tile-f {
      grid-column: 5 / 13;
      margin-top: 2rem;
    }

    .tile-caption {
      opacity: 0;
      transform: translateY(0.25rem);
      transition:
        opacity 0.35s ease,
        transform 0.35s var(--ease-out-soft);
    }

    .tile:hover .tile-caption,
    .tile:focus-within .tile-caption {
      opacity: 1;
      transform: none;
    }
  }

  /* Each tile drifts at a slightly different speed as it crosses the screen. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .tile {
        animation: drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
        --from: 2.5rem;
        --to: -2.5rem;
      }
      .tile:nth-child(3n + 2) {
        --from: 4.5rem;
        --to: -4.5rem;
      }
      .tile:nth-child(3n) {
        --from: 1rem;
        --to: -1rem;
      }
      @keyframes drift {
        from {
          transform: translateY(var(--from));
        }
        to {
          transform: translateY(var(--to));
        }
      }
    }
  }
</style>
