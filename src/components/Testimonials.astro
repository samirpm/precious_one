---
import { Picture } from 'astro:assets';
import { photoById } from '../data/photos';
import { testimonials } from '../data/studio';

const quotes = testimonials.map((t) => ({ ...t, photo: photoById(t.photo) }));
---

<!-- Each family's words sit under a photograph from their own session. -->
<section class="section kind" aria-labelledby="kind-title">
  <div class="wrap">
    <h2 id="kind-title" class="display title-lg reveal">Kind words from families</h2>
    <ul class="quotes no-scrollbar">
      {quotes.map((t, i) => (
        <li class="quote">
          <div class="frame quote-frame reveal-clip" style={`--d: ${i * 0.12}s`}>
            <Picture
              src={t.photo.src}
              alt={t.photo.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 768px) 30vw, 84vw"
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
            />
          </div>
          <blockquote class="reveal" style={`--d: ${0.15 + i * 0.12}s`}>
            <p class="quote-text">“{t.quote}”</p>
            <footer>
              <cite class="quote-name">{t.name}</cite>
              <span class="meta">{t.detail}</span>
            </footer>
          </blockquote>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .kind {
    background: var(--color-blush);
    --cover: var(--color-blush);
  }

  .kind h2 {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    max-width: 8em;
  }

  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(-1 * clamp(1.25rem, 5vw, 4.5rem));
    padding-inline: clamp(1.25rem, 5vw, 4.5rem);
    scroll-padding-inline: clamp(1.25rem, 5vw, 4.5rem);
  }

  .quote {
    flex: 0 0 84vw;
    max-width: 30rem;
    scroll-snap-align: start;
  }

  .quote-frame {
    aspect-ratio: 5 / 4;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .quotes {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 4rem);
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      align-items: start;
    }
    .quote {
      max-width: none;
    }
    /* The middle column sits lower, like prints laid out on a table. */
    .quote:nth-child(2) {
      margin-top: 3.5rem;
    }
  }

  blockquote {
    margin: 0;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .quote-text {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.8vw, 1.75rem);
    line-height: 1.3;
    text-wrap: pretty;
  }

  blockquote footer {
    display: grid;
    gap: 0.2rem;
  }

  .quote-name {
    font-style: normal;
    font-weight: 500;
    font-size: 0.9375rem;
  }
</style>
