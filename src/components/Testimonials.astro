---
import { testimonials } from '../data/studio';
---

<section class="section kind" aria-labelledby="kind-title">
  <div class="wrap">
    <h2 id="kind-title" class="display title-lg reveal">Kind words from families</h2>
    <ul class="quotes no-scrollbar">
      {testimonials.map((t, i) => (
        <li class="quote reveal" style={`--d: ${0.1 + i * 0.1}s`}>
          <blockquote>
            <p class="quote-text">“{t.quote}”</p>
            <footer>
              <cite class="quote-name">{t.name}</cite>
              <span class="meta">{t.detail}</span>
            </footer>
          </blockquote>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .kind {
    background: var(--color-blush);
  }

  .kind h2 {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    max-width: 8em;
  }

  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(-1 * clamp(1.25rem, 5vw, 4.5rem));
    padding-inline: clamp(1.25rem, 5vw, 4.5rem);
    scroll-padding-inline: clamp(1.25rem, 5vw, 4.5rem);
  }

  .quote {
    flex: 0 0 84vw;
    max-width: 30rem;
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .quotes {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 4rem);
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
    .quote {
      max-width: none;
    }
  }

  blockquote {
    margin: 0;
    display: grid;
    gap: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    height: 100%;
    align-content: start;
  }

  .quote-text {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.8vw, 1.75rem);
    line-height: 1.3;
    text-wrap: pretty;
  }

  blockquote footer {
    display: grid;
    gap: 0.2rem;
  }

  .quote-name {
    font-style: normal;
    font-weight: 500;
    font-size: 0.9375rem;
  }
</style>
