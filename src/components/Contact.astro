---
import { Picture } from 'astro:assets';
import { photoById } from '../data/photos';
import { studio, telLink, whatsappLink } from '../data/studio';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import Words from './Words.astro';

interface Props {
  /** Pre-filled WhatsApp message, e.g. naming the session the visitor was reading about. */
  message?: string;
  photoId?: string;
}

const { message = 'Hello Precious One, I would like to plan a session.', photoId = 'basket' } = Astro.props;
const photo = photoById(photoId);
---

<section id="contact" class="section contact" aria-labelledby="contact-title" data-contact>
  <div class="wrap contact-grid">
    <div class="contact-body">
      <h2 id="contact-title" class="display title-lg words words-reveal"><Words text="Let’s plan your session" /></h2>
      <p class="lede reveal" style="--d: 0.1s">
        Send us your due date, or your baby’s age, and the kind of photographs you have in mind. We reply the same day.
      </p>
      <div class="contact-actions reveal" style="--d: 0.2s">
        <a class="btn btn-primary" href={whatsappLink(message)} target="_blank" rel="noopener">
          <WhatsAppIcon />
          Chat on WhatsApp
        </a>
        <a class="btn btn-outline" href={telLink}>Call {studio.phone}</a>
      </div>

      <dl class="contact-details reveal" style="--d: 0.3s">
        <div>
          <dt>Email</dt>
          <dd><a class="link-line" href={`mailto:${studio.email}`}>{studio.email}</a></dd>
        </div>
        <div>
          <dt>Instagram</dt>
          <dd><a class="link-line" href={studio.instagram} target="_blank" rel="noopener">@preciousonephotography</a></dd>
        </div>
        <div>
          <dt>Studio</dt>
          <dd>{studio.address}</dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd>{studio.hours}</dd>
        </div>
      </dl>
    </div>

    <div class="frame frame-drift contact-frame reveal-clip">
      <Picture
        src={photo.src}
        alt={photo.alt}
        widths={[480, 768, 1024]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        formats={['avif', 'webp']}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-parchment);
    --cover: var(--color-parchment);
  }

  .contact-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(3rem, 7vw, 7rem);
      align-items: center;
    }
  }

  .contact-body {
    display: grid;
    gap: 1.5rem;
  }

  .contact-body h2 {
    max-width: 7.5em;
  }

  .contact-body .lede {
    max-width: 40ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .contact-details {
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .contact-details dt {
    font-size: 0.8125rem;
    color: var(--color-cocoa);
    margin-bottom: 0.2rem;
  }

  .contact-details dd {
    margin: 0;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .contact-frame {
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 1023px) {
    .contact-frame {
      aspect-ratio: 3 / 2;
    }
  }
</style>
