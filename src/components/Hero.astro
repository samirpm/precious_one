---
import { Picture, getImage } from 'astro:assets';
import type { Photo } from '../data/photos';
import { heroPhotoIds, photoById } from '../data/photos';
import { whatsappLink } from '../data/studio';
import Words from './Words.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

const slides = heroPhotoIds.map(photoById);
const [first, ...rest] = slides;
const widthsFor = (p: Photo) => [480, 768, 1024, 1440, Math.min(p.src.width, 1600)];

// Only the first slide is a real <img> at load. The others are written with
// data- attributes and upgraded after the page has loaded, so a phone decodes
// one hero photograph instead of four before it can paint.
const deferred = await Promise.all(
  rest.map(async (photo) => {
    const avif = await getImage({ src: photo.src, widths: widthsFor(photo), format: 'avif' });
    const webp = await getImage({ src: photo.src, widths: widthsFor(photo), format: 'webp' });
    return {
      photo,
      avif: avif.srcSet.attribute,
      webp: webp.srcSet.attribute,
      src: webp.src,
      width: webp.attributes.width,
      height: webp.attributes.height,
    };
  }),
);
---

<!--
  The photograph fills the screen. The copy sits in an ink "gallery label"
  overlapping its lower-left corner, so the headline never has to fight a
  bright, backlit image for legibility. On phones the label becomes a panel
  beneath the photograph.
-->
<section class="hero" data-hero aria-label="Welcome">
  <div class="hero-media" aria-hidden="true">
    <div class="hero-parallax">
      <div class="slide frame is-active" data-slide style={`--pos: ${first.position ?? '50% 50%'}`}>
        <Picture
          src={first.src}
          alt=""
          widths={widthsFor(first)}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </div>
      {deferred.map((slide) => (
        <div class="slide frame" data-slide data-deferred style={`--pos: ${slide.photo.position ?? '50% 50%'}`}>
          <picture>
            <source type="image/avif" data-srcset={slide.avif} sizes="100vw" />
            <source type="image/webp" data-srcset={slide.webp} sizes="100vw" />
            <img data-src={slide.src} alt="" width={slide.width} height={slide.height} decoding="async" />
          </picture>
        </div>
      ))}
    </div>
    <div class="hero-scrim"></div>
  </div>

  <div class="hero-foot rise" style="--r: 1.1s">
    <p class="hero-caption" data-hero-caption>{slides[0].caption}</p>
    <div class="hero-dots" role="group" aria-label="Choose photograph">
      {slides.map((photo, i) => (
        <button
          type="button"
          class:list={['dot', { 'is-active': i === 0 }]}
          data-dot={i}
          aria-label={`Show photograph ${i + 1}: ${photo.caption}`}
          aria-pressed={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>
  </div>

  <div class="hero-panel">
    <h1 class="display words">
      <Words text="Your baby’s first days, photographed with tenderness." />
    </h1>
    <p class="hero-sub rise" style="--r: 0.75s">
      A private, women-only newborn and family studio in Abu Dhabi.
    </p>
    <div class="hero-actions rise" style="--r: 0.9s">
      <a
        class="btn btn-primary"
        href={whatsappLink('Hello Precious One, I would like to ask about a newborn session.')}
        target="_blank"
        rel="noopener"
      >
        <WhatsAppIcon />
        Chat on WhatsApp
      </a>
      <a class="btn btn-light" href="#work">See our work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    --gutter: clamp(1.25rem, 5vw, 4.5rem);
    position: relative;
    display: grid;
    grid-template-rows: 62svh auto;
    min-height: 100svh;
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .hero-media {
    position: relative;
    overflow: hidden;
    background: var(--color-ink-soft);
  }

  .hero-parallax {
    position: absolute;
    inset: 0;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s ease;
  }

  .slide.is-active {
    opacity: 1;
  }

  .slide :global(img) {
    object-position: var(--pos);
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: no-preference) {
    .slide.is-active :global(img) {
      animation: settle 9s linear forwards;
    }
  }

  @keyframes settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  /* Keeps the floating header legible over the top of the photograph, and
     the caption over its foot. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(28, 22, 18, 0.45) 0%, rgba(28, 22, 18, 0) 32%),
      linear-gradient(to top, rgba(28, 22, 18, 0.5) 0%, rgba(28, 22, 18, 0) 26%);
    pointer-events: none;
  }

  .hero-foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: calc(62svh - 3.25rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    z-index: 2;
  }

  .hero-caption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.25;
    max-width: 62%;
    color: color-mix(in srgb, var(--color-white) 86%, transparent);
    text-shadow: 0 1px 12px rgba(28, 22, 18, 0.4);
    transition: opacity 0.5s ease;
  }

  .hero-caption.is-fading {
    opacity: 0;
  }

  .hero-dots {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }

  .dot {
    width: 2rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dot::before {
    content: '';
    display: block;
    height: 1px;
    background: color-mix(in srgb, var(--color-white) 45%, transparent);
    transition: background-color 0.3s ease;
  }

  .dot.is-active::before {
    background: var(--color-sand);
  }

  .hero-panel {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    align-content: center;
    padding: 2.25rem var(--gutter) max(2rem, env(safe-area-inset-bottom));
  }

  .hero h1 {
    font-size: clamp(2.5rem, 10.5vw, 3.6rem);
    max-width: 11em;
    color: var(--color-ivory);
  }

  .hero-sub {
    max-width: 34ch;
    font-size: 1.0625rem;
    color: color-mix(in srgb, var(--color-ivory) 78%, transparent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* Full-bleed photograph with an overlapping label from tablets up */
  @media (min-width: 1024px) {
    .hero {
      display: block;
      height: 100svh;
      min-height: 42rem;
      max-height: 68rem;
    }

    .hero-media {
      position: absolute;
      inset: 0;
    }

    .hero-foot {
      top: auto;
      bottom: 2rem;
      left: auto;
      right: var(--gutter);
      width: min(30rem, 34vw);
    }

    .hero-panel {
      position: absolute;
      left: var(--gutter);
      bottom: 0;
      width: min(40rem, 46vw);
      padding: 2.75rem 2.75rem 3rem;
      gap: 1.4rem;
      background: var(--color-ink);
    }

    .hero h1 {
      font-size: clamp(3rem, 3.9vw, 4.5rem);
      max-width: 10.5em;
    }

    .hero-sub {
      font-size: 1.125rem;
    }
  }

  /* The photograph drifts up slightly slower than the page as it leaves. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .hero-parallax {
        inset: -12% 0 0;
        animation: hero-drift linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }

      @keyframes hero-drift {
        to {
          transform: translateY(12%);
        }
      }
    }
  }

  /* Page-load choreography: words rise, then the supporting copy. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .rise {
      opacity: 0;
      transform: translateY(0.75rem);
      animation: rise 0.9s var(--ease-out-soft) forwards;
      animation-delay: calc(var(--start, 0.2s) + var(--r, 0.8s));
    }
    :global(html.js) .hero-panel {
      animation: panel-in 1s var(--ease-out-soft) both;
      animation-delay: var(--start, 0.2s);
    }
    :global(html.has-intro:not(.intro-seen)) .hero {
      --start: 1.5s;
    }
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const caption = hero.querySelector<HTMLElement>('[data-hero-caption]');
    const captions = dots.map((d) => (d.getAttribute('aria-label') || '').replace(/^Show photograph \d+: /, ''));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const INTERVAL = 6500;
    let index = 0;
    let timer = 0;

    // Swap the data- attributes into real ones once the page is idle.
    let upgraded = false;
    const upgrade = () => {
      if (upgraded) return;
      upgraded = true;
      hero.querySelectorAll<HTMLElement>('[data-deferred] source, [data-deferred] img').forEach((el) => {
        const srcset = el.getAttribute('data-srcset');
        const src = el.getAttribute('data-src');
        if (srcset) el.setAttribute('srcset', srcset);
        if (src) el.setAttribute('src', src);
      });
    };
    const scheduleUpgrade = () => {
      if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(upgrade, { timeout: 2500 });
      else window.setTimeout(upgrade, 1200);
    };
    if (document.readyState === 'complete') scheduleUpgrade();
    else window.addEventListener('load', scheduleUpgrade, { once: true });

    const show = (next: number) => {
      upgrade();
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === index);
        d.setAttribute('aria-pressed', String(i === index));
      });
      if (caption) {
        caption.classList.add('is-fading');
        window.setTimeout(() => {
          caption.textContent = captions[index] ?? '';
          caption.classList.remove('is-fading');
        }, 450);
      }
    };

    const start = () => {
      stop();
      if (reduced || document.hidden) return;
      timer = window.setInterval(() => show(index + 1), INTERVAL);
    };
    const stop = () => window.clearInterval(timer);

    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        show(i);
        start();
      }),
    );
    document.addEventListener('visibilitychange', start);

    // Only keep cycling while the hero is on screen.
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.2 }).observe(hero);
  }
</script>
