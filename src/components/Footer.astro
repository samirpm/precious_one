---
import { studio, services, telLink, whatsappLink } from '../data/studio';

const year = new Date().getFullYear();
---

<footer class="footer dark">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="display footer-name">{studio.shortName}</p>
        <p class="meta">{studio.tagline}</p>
      </div>

      <nav aria-label="Sessions" class="footer-col">
        <p class="footer-heading">Sessions</p>
        <ul>
          {services.map((s) => (
            <li><a href={`/services/${s.id}/`}>{s.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Site" class="footer-col">
        <p class="footer-heading">Explore</p>
        <ul>
          <li><a href="/#work">Work</a></li>
          <li><a href="/#studio">The studio</a></li>
          <li><a href="/#questions">Questions</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-heading">Get in touch</p>
        <ul>
          <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={telLink}>{studio.phone}</a></li>
          <li><a href={`mailto:${studio.email}`}>{studio.email}</a></li>
          <li><a href={studio.instagram} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
        <p class="meta footer-address">{studio.address}<br />{studio.hours}</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="meta">© {year} {studio.name}</p>
      <p class="meta">Made with love in {studio.city}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem);
  }

  /* Leave room for the phone action bar */
  @media (max-width: 767px) {
    .footer {
      padding-bottom: 6.5rem;
    }
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr 1fr;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    }
  }

  .footer-brand {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .footer-brand {
      grid-column: auto;
    }
  }

  .footer-name {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: 0.9rem;
    color: var(--color-sand);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .footer-col a {
    color: color-mix(in srgb, var(--color-ivory) 82%, transparent);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--color-ivory);
  }

  .footer-address {
    margin-top: 1.25rem;
  }

  .footer-bottom {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ivory) 12%, transparent);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
</style>
