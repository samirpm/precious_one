---
import { Picture } from 'astro:assets';
import { photoById } from '../data/photos';
import { fromPrice, services } from '../data/studio';
import Words from './Words.astro';

const [feature, ...rest] = services;
const featurePhoto = photoById(feature.photos[0]);
---

<section id="sessions" class="section sessions" aria-labelledby="sessions-title">
  <div class="wrap">
    <div class="sessions-head">
      <h2 id="sessions-title" class="display title-lg words words-reveal"><Words text="Sessions" /></h2>
      <p class="lede">From the first two weeks to the first birthday, and the family around them.</p>
    </div>

    <a href={`/services/${feature.id}/`} class="feature">
      <div class="frame frame-drift feature-frame reveal-clip" data-tilt>
        <Picture
          src={featurePhoto.src}
          alt={featurePhoto.alt}
          widths={[480, 768, 1024, Math.min(featurePhoto.src.width, 1400)]}
          sizes="(min-width: 1024px) 55vw, 100vw"
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="feature-body reveal" style="--d: 0.15s">
        <p class="feature-kicker">Our speciality</p>
        <h3 class="display title-md">{feature.title}</h3>
        <p class="prose-soft feature-story">{feature.story}</p>
        <p class="meta">{feature.idealFor}</p>
        <p class="feature-price">From {fromPrice(feature)}</p>
        <span class="link-line">About newborn sessions</span>
      </div>
    </a>

    <ul class="sessions-grid">
      {rest.map((service, i) => {
        const photo = photoById(service.photos[0]);
        return (
          <li>
            <a href={`/services/${service.id}/`} class="card">
              <div class="frame frame-drift card-frame reveal-clip" style={`--d: ${i * 0.08}s`} data-tilt>
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  widths={[320, 480, 640, 800]}
                  sizes="(min-width: 1024px) 18vw, (min-width: 640px) 30vw, 46vw"
                  formats={['avif', 'webp']}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3 class="title-sm card-title">{service.name}</h3>
              <p class="small card-summary">{service.summary}</p>
              <p class="meta">From {fromPrice(service)}</p>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .sessions-head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .sessions-head .lede {
    max-width: 34ch;
  }

  @media (min-width: 768px) {
    .sessions-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .feature {
    display: grid;
    gap: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .feature {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
    }
  }

  .feature-frame {
    aspect-ratio: 5 / 4;
  }

  .feature-frame :global(img) {
    transition: transform 1.2s var(--ease-out-soft);
  }

  @media (hover: hover) {
    .feature:hover .feature-frame :global(img) {
      transform: scale(1.03);
    }
  }

  .feature-body {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  .feature-kicker {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--color-clay);
  }

  .feature-story {
    max-width: 48ch;
  }

  .feature-price {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .feature .link-line {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .sessions-grid {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.75rem 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 640px) {
    .sessions-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }
  }

  /* Editorial rhythm: three portrait cards, then two wide ones. */
  @media (min-width: 1024px) {
    .sessions-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
    .sessions-grid li:nth-child(-n + 3) {
      grid-column: span 2;
    }
    .sessions-grid li:nth-child(n + 4) {
      grid-column: span 3;
    }
    .sessions-grid li:nth-child(n + 4) .card-frame {
      aspect-ratio: 16 / 10;
    }
  }

  .card {
    display: grid;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .card-frame {
    aspect-ratio: 4 / 5;
    margin-bottom: 0.35rem;
  }

  .card-frame :global(img) {
    transition: transform 1.2s var(--ease-out-soft);
  }

  @media (hover: hover) {
    .card:hover .card-frame :global(img) {
      transform: scale(1.04);
    }
  }

  .card-summary {
    color: var(--color-cocoa);
    text-wrap: pretty;
  }
</style>
