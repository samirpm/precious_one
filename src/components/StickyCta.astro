---
import { studio, telLink, whatsappLink } from '../data/studio';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---

<!-- Phone-only action bar. Slides in once the hero has scrolled away. -->
<div class="sticky-cta" data-sticky-cta>
  <a href={whatsappLink('Hello Precious One, I would like to ask about a session.')} class="btn btn-primary" target="_blank" rel="noopener">
    <WhatsAppIcon />
    WhatsApp
  </a>
  <a href={telLink} class="btn btn-outline" aria-label={`Call ${studio.phone}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>
    </svg>
    Call
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 0.6rem;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--color-ivory) 96%, transparent);
    box-shadow: 0 -1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
    transform: translateY(110%);
    transition: transform 0.45s var(--ease-out-soft);
  }

  .sticky-cta.is-shown {
    transform: none;
  }

  .sticky-cta .btn-outline {
    background: var(--color-white);
  }

  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }

  :global(html.menu-open) .sticky-cta,
  :global(html.lightbox-open) .sticky-cta {
    transform: translateY(110%);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const footerContact = document.querySelector<HTMLElement>('[data-contact]');
  if (bar) {
    if (hero) {
      let pastHero = false;
      let onContact = false;
      const update = () => bar.classList.toggle('is-shown', pastHero && !onContact);
      new IntersectionObserver(
        ([e]) => {
          pastHero = !e.isIntersecting;
          update();
        },
        { threshold: 0.15 },
      ).observe(hero);
      if (footerContact) {
        new IntersectionObserver(
          ([e]) => {
            onContact = e.isIntersecting;
            update();
          },
          { threshold: 0.3 },
        ).observe(footerContact);
      }
    } else {
      bar.classList.add('is-shown');
    }
  }
</script>
